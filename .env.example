# ShePlates runs in DEMO_MODE without external services.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Optional production integrations
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LOCAL TESTING ONLY. These two flags let the server auto-confirm newly created
# customer/vendor accounts without sending email. Never enable in production.
NEXT_PUBLIC_TEST_AUTO_CONFIRM=false
SHEPLATES_TEST_AUTO_CONFIRM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=sheplates_schedule_reminder
MAPS_API_KEY=

# Scheduled cleanup of expired customer statuses (POST /api/statuses/purge with header x-cron-secret)
STATUS_PURGE_SECRET=
